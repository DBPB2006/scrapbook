# Defense-in-depth root .dockerignore for non-BuildKit Docker builds.
# Note: BuildKit also reads per-service <service>/Dockerfile.dockerignore files.

.git/
.gitignore
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Infrastructure, CI/CD, Kubernetes manifests & Frontend
.terraform/
**/.terraform/
terraform/
*.tfstate*
*.tfvars*
deployment/
client/
scripts/
Jenkinsfile*
README.md
*.md
*.pdf
*.png

# Scan reports & runtime/local artifacts
reports/
trivy-reports/
coverage/
.nyc_output/
uploads/
**/uploads/
data/
**/data/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets & environment files
.env
.env.*
**/.env
**/.env.*
*.pem
*.key

# Host Node dependencies (installed cleanly inside container)
node_modules/
**/node_modules/

