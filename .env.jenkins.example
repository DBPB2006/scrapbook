# ==============================================================================
# Scrapbook — Jenkins Deployment Secrets Template
# ==============================================================================
# Copy this file to `.env.jenkins` locally (gitignored), fill in your actual
# production values, and upload `.env.jenkins` to Jenkins as a Secret file
# credential with exact ID: `deployment-env`.
#
# NEVER commit `.env.jenkins` or real secrets to Git.
# NEVER embed kubeconfig contents inside this file (keep `k8s-kubeconfig` separate).
# ==============================================================================

# Terraform outputs: media_bucket_name, frontend_bucket_name, alb_url
MEDIA_S3_BUCKET=replace-with-terraform-media-bucket-name
FRONTEND_S3_BUCKET=replace-with-terraform-frontend-bucket-name
ALB_API_URL=http://replace-with-terraform-alb-dns-name

# Optional explicit frontend CORS origin override (defaults to http://<FRONTEND_S3_BUCKET>.s3-website.ap-south-1.amazonaws.com)
# FRONTEND_ORIGIN=

# JWT signing secret shared between auth-service and gateway-service
JWT_SECRET=replace-with-strong-random-jwt-secret

# Shared secret for microservice-to-microservice internal API calls
INTERNAL_SERVICE_SECRET=replace-with-strong-random-internal-service-secret

# Shared secret injected by gateway-service and verified by downstream services
GATEWAY_SHARED_SECRET=replace-with-strong-random-gateway-shared-secret

# Existing MongoDB 8.0 connection URI on the private DB EC2 instance (10.0.21.241)
# Note: URL-encode special characters in password (e.g. @ : / ? # % & +)
MONGODB_URI=mongodb://scrapbook_app:<URL_ENCODED_PASSWORD>@10.0.21.241:27017/scrapbook?authSource=scrapbook

# Grafana admin password stored in Kubernetes secret `grafana-secret` (key: admin-password)
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-admin-password

# Public browser LocationIQ key injected into client/js/config.js during S3 sync
# Restrict this key via HTTP Referrer rules in your LocationIQ dashboard
LOCATIONIQ_API_KEY=replace-with-referrer-restricted-locationiq-key
