PORT=3003
NODE_ENV=development
INTERNAL_SERVICE_SECRET=your-internal-service-secret-here
GATEWAY_SHARED_SECRET=your-gateway-shared-secret-here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=memorybook-media-bucket
AUTH_SERVICE_URL=http://auth-service:3001
MEMORIES_SERVICE_URL=http://memories-service:3002
# Local unauthenticated development URI:
MONGODB_URI=mongodb://127.0.0.1:27017/memorybook
# Authenticated least-privilege URI (required in production; run scripts/init-mongodb.sh first):
# MONGODB_URI=mongodb://<app_user>:<url_encoded_app_password>@127.0.0.1:27017/memorybook?authSource=memorybook
MONGODB_DATABASE=memorybook
MONGODB_AUTH_SOURCE=memorybook

# Optional MongoDB driver & resilience defaults (shared/mongodb.js)
# MONGODB_POOL_MAX=20
# MONGODB_POOL_MIN=2
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
# MONGODB_HEARTBEAT_FREQUENCY_MS=10000
# MONGODB_FAIL_FAST=false
# MONGODB_RETRY_BASE_MS=2000
# MONGODB_RETRY_MAX_MS=30000
# MONGODB_TLS=false
# MONGODB_CA_PATH=
